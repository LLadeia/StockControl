# Configuração do back-end.
#
# Copie este arquivo para .env e ajuste os valores:
#     cp .env.example .env
# O .env nunca é versionado.

# True somente em desenvolvimento. Em produção, deixe False.
DEBUG=True

# Obrigatória quando DEBUG=False: a aplicação se recusa a subir sem uma chave
# forte (50+ caracteres, sem o prefixo "django-insecure-"). Gere uma com:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
# Com DEBUG=True pode ficar vazia; uma chave de desenvolvimento é usada.
SECRET_KEY=

# Hosts pelos quais a API pode ser acessada, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do front-end autorizadas a chamar a API (CORS), separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# True libera qualquer origem. Não use em produção.
CORS_ALLOW_ALL_ORIGINS=False
