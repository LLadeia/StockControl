# Configuração do front-end.
#
# Copie este arquivo para .env e ajuste os valores:
#     cp .env.example .env
# O .env nunca é versionado.
#
# Variáveis VITE_* são embutidas no JavaScript em tempo de build e ficam
# visíveis no navegador: nunca coloque segredos aqui.

# Endereço base da API do Django, terminando em /api/.
VITE_API_URL=http://127.0.0.1:8000/api/
