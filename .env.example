# Configuração opcional do docker compose.
#
# `docker compose up --build` funciona sem este arquivo. Copie-o para .env
# (nesta pasta) apenas se quiser mudar algum padrão. O .env nunca é versionado.

# Portas publicadas na sua máquina.
WEB_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432

# Banco de dados.
POSTGRES_DB=stockcontrol
POSTGRES_USER=stockcontrol
POSTGRES_PASSWORD=stockcontrol

# Por padrão o compose sobe em modo de desenvolvimento. Para rodar como em
# produção, use DEBUG=False e defina uma SECRET_KEY forte:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
